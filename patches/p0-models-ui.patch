diff --git a/apps/mobile/lib/model-provider-label.ts b/apps/mobile/lib/model-provider-label.ts
new file mode 100644
index 0000000..aea2f9d
--- /dev/null
+++ b/apps/mobile/lib/model-provider-label.ts
@@ -0,0 +1,22 @@
+import { OPENAI_COMPATIBLE_PROVIDER_ID } from "@rakazo/contracts";
+
+/**
+ * A third-party OpenAI-compatible server is the entry most people add by hand, so it is named for
+ * what it is rather than after the wire protocol. It stays Chinese in every locale, the way the
+ * provider names the catalog sends are not translated either.
+ */
+export const THIRD_PARTY_COMPATIBLE_NAME = "OpenAI 兼容（第三方）";
+
+/**
+ * The name the app shows for a provider. The plain compatible entry — no hosted endpoint preset —
+ * reads as the third-party one; a preset keeps the name the catalog gives it.
+ */
+export function providerDisplayName(
+  provider: string,
+  name: string,
+  hasEndpointPreset = false,
+): string {
+  return provider === OPENAI_COMPATIBLE_PROVIDER_ID && !hasEndpointPreset
+    ? THIRD_PARTY_COMPATIBLE_NAME
+    : name;
+}
