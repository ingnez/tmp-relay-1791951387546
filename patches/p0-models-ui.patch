+/**
+ * A server the person runs themselves heads the list: it is the entry people add by hand, and
+ * sorting by name would bury it among the O's of the hosted providers.
+ */
+function thirdPartyCompatibleFirst(providers: ConnectableProvider[]): ConnectableProvider[] {
+  const index = providers.findIndex(
+    (provider) => provider.id === OPENAI_COMPATIBLE_PROVIDER_ID && !provider.baseUrl,
+  );
+  if (index <= 0) return providers;
+  const [compatible] = providers.splice(index, 1);
+  return compatible ? [compatible, ...providers] : providers;
+}
