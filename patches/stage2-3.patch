diff --git a/apps/mobile/lib/count-label.ts b/apps/mobile/lib/count-label.ts
new file mode 100644
index 0000000..8cae3d8
--- /dev/null
+++ b/apps/mobile/lib/count-label.ts
@@ -0,0 +1,28 @@
+import { getActiveUiLocale } from "./i18n";
+
+/**
+ * Counts with their noun, written out instead of through an ICU plural template. A catalog that
+ * never received the template renders its source verbatim — `{count, plural, one {# model} other
+ * {# models}}` in the middle of the provider list — so these strings are built here, where the
+ * number is always substituted.
+ */
+function formatCount(count: number): string {
+  return new Intl.NumberFormat().format(count);
+}
+
+function isChinese(): boolean {
+  const locale = getActiveUiLocale();
+  return locale === "zh-CN" || locale === "zh-TW";
+}
+
+/** "8 个模型" / "8 models". */
+export function modelCountLabel(count: number): string {
+  if (isChinese()) return `${formatCount(count)} 个模型`;
+  return count === 1 ? "1 model" : `${formatCount(count)} models`;
+}
+
+/** "3 条与 Grok 的消息" / "3 messages with Grok". */
+export function messagesWithLabel(count: number, peer: string): string {
+  if (isChinese()) return `${formatCount(count)} 条与 ${peer} 的消息`;
+  return count === 1 ? `1 message with ${peer}` : `${formatCount(count)} messages with ${peer}`;
+}
diff --git a/apps/mobile/lib/main-bot.ts b/apps/mobile/lib/main-bot.ts
new file mode 100644
index 0000000..1d27eda
--- /dev/null
+++ b/apps/mobile/lib/main-bot.ts
@@ -0,0 +1,64 @@
+import * as SecureStore from "expo-secure-store";
+
+/**
+ * The bot shown at the top of the home screen. Rakazo keeps a bot's pinned state on the server but
+ * has no "main bot", so this choice stays on the device, per account and Space.
+ */
+const listeners = new Set<() => void>();
+let mainBotId: string | null = null;
+let loadedKey: string | null = null;
+
+function notify(): void {
+  for (const listener of listeners) listener();
+}
+
+function keyFor(userId: string, spaceId: string): string {
+  return `rakazo.main-bot.${userId}.${spaceId}`;
+}
+
+export function getMainBotId(): string | null {
+  return mainBotId;
+}
+
+export function subscribeMainBot(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export async function loadMainBot(userId: string, spaceId: string): Promise<string | null> {
+  const key = keyFor(userId, spaceId);
+  if (key === loadedKey) return mainBotId;
+  loadedKey = key;
+  try {
+    mainBotId = await SecureStore.getItemAsync(key);
+  } catch {
+    mainBotId = null;
+  }
+  notify();
+  return mainBotId;
+}
+
+export async function setMainBot(userId: string, spaceId: string, botId: string): Promise<void> {
+  const key = keyFor(userId, spaceId);
+  loadedKey = key;
+  mainBotId = botId;
+  notify();
+  try {
+    await SecureStore.setItemAsync(key, botId);
+  } catch {
+    // SecureStore is unavailable on some hosts; the choice stays for this session.
+  }
+}
+
+/**
+ * The bot the home screen puts first: the chosen one while it is still in the list, else the first
+ * chat, so a deleted or archived main bot never leaves the hero empty.
+ */
+export function resolveMainBot<T extends { id: string }>(
+  bots: readonly T[],
+  chosenId: string | null = mainBotId,
+): T | undefined {
+  return bots.find((bot) => bot.id === chosenId) ?? bots[0];
+}
diff --git a/apps/mobile/lib/model-provider-label.ts b/apps/mobile/lib/model-provider-label.ts
new file mode 100644
index 0000000..aea2f9d
--- /dev/null
+++ b/apps/mobile/lib/model-provider-label.ts
@@ -0,0 +1,22 @@
+import { OPENAI_COMPATIBLE_PROVIDER_ID } from "@rakazo/contracts";
+
+/**
+ * A third-party OpenAI-compatible server is the entry most people add by hand, so it is named for
+ * what it is rather than after the wire protocol. It stays Chinese in every locale, the way the
+ * provider names the catalog sends are not translated either.
+ */
+export const THIRD_PARTY_COMPATIBLE_NAME = "OpenAI 兼容（第三方）";
+
+/**
+ * The name the app shows for a provider. The plain compatible entry — no hosted endpoint preset —
+ * reads as the third-party one; a preset keeps the name the catalog gives it.
+ */
+export function providerDisplayName(
+  provider: string,
+  name: string,
+  hasEndpointPreset = false,
+): string {
+  return provider === OPENAI_COMPATIBLE_PROVIDER_ID && !hasEndpointPreset
+    ? THIRD_PARTY_COMPATIBLE_NAME
+    : name;
+}
diff --git a/apps/mobile/lib/scenario-models.ts b/apps/mobile/lib/scenario-models.ts
new file mode 100644
index 0000000..9316e5c
--- /dev/null
+++ b/apps/mobile/lib/scenario-models.ts
@@ -0,0 +1,163 @@
+import type { ThinkingLevel } from "@rakazo/contracts";
+import * as SecureStore from "expo-secure-store";
+
+/**
+ * The scenario slots that belong to no server role: the server still knows main, approval and
+ * computer-use, so these live on the device and are handed to the router through
+ * `scenarioRoutingSnapshot`. 日常帮助 is the server's main model and keeps its own screen, and
+ * 审批 has its own role too.
+ */
+export type ScenarioSlotId = "fast" | "code" | "heavy" | "image" | "video";
+
+export const SCENARIO_SLOT_IDS: readonly ScenarioSlotId[] = ["fast", "code", "heavy", "image", "video"];
+
+/** The thinking level a slot runs at until the person picks another one. */
+export const SCENARIO_DEFAULT_THINKING: Record<ScenarioSlotId, ThinkingLevel | null> = {
+  // Answers in the first second: thinking would only delay the first token.
+  fast: "minimal",
+  code: "medium",
+  heavy: "high",
+  // Pictures and video have no reasoning to spend.
+  image: null,
+  video: null,
+};
+
+/** Slots that show a thinking control; a picture or a video has nothing to think about. */
+export function scenarioHasThinking(slot: ScenarioSlotId): boolean {
+  return SCENARIO_DEFAULT_THINKING[slot] !== null;
+}
+
+export type ScenarioModelChoice = {
+  provider: string;
+  modelId: string;
+  credentialId?: string;
+  /** Unset means the slot's own default in `SCENARIO_DEFAULT_THINKING`. */
+  thinkingLevel?: ThinkingLevel | null;
+};
+
+export type ScenarioModels = Partial<Record<ScenarioSlotId, ScenarioModelChoice>>;
+
+/** A slot as the router reads it: its own model, or the daily model it falls back to. */
+export type ResolvedScenarioSlot = {
+  model: ScenarioModelChoice;
+  thinkingLevel: ThinkingLevel | null;
+  /** Where the model came from: the slot's own choice, or 日常帮助's. */
+  source: "slot" | "daily";
+};
+
+let state: ScenarioModels = {};
+let storageKey: string | null = null;
+const listeners = new Set<() => void>();
+
+function notify(): void {
+  for (const listener of listeners) listener();
+}
+
+function keyFor(userId: string, spaceId: string): string {
+  return `rakazo.scenario-models.${userId}.${spaceId}`;
+}
+
+export function getScenarioModels(): ScenarioModels {
+  return state;
+}
+
+export function subscribeScenarioModels(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+function parse(raw: string | null): ScenarioModels {
+  if (!raw) return {};
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (!parsed || typeof parsed !== "object") return {};
+    const next: ScenarioModels = {};
+    for (const slot of SCENARIO_SLOT_IDS) {
+      const value = (parsed as Record<string, unknown>)[slot];
+      if (!value || typeof value !== "object") continue;
+      const entry = value as Record<string, unknown>;
+      if (typeof entry.provider !== "string" || typeof entry.modelId !== "string") continue;
+      if (!entry.provider || !entry.modelId) continue;
+      next[slot] = {
+        provider: entry.provider,
+        modelId: entry.modelId,
+        ...(typeof entry.credentialId === "string" ? { credentialId: entry.credentialId } : {}),
+        ...(typeof entry.thinkingLevel === "string"
+          ? { thinkingLevel: entry.thinkingLevel as ThinkingLevel }
+          : {}),
+      };
+    }
+    return next;
+  } catch {
+    return {};
+  }
+}
+
+/** Reads this account's and Space's slots once; a later call for the same pair reuses them. */
+export async function loadScenarioModels(userId: string, spaceId: string): Promise<ScenarioModels> {
+  const key = keyFor(userId, spaceId);
+  if (key === storageKey) return state;
+  storageKey = key;
+  try {
+    state = parse(await SecureStore.getItemAsync(key));
+  } catch {
+    state = {};
+  }
+  notify();
+  return state;
+}
+
+export async function saveScenarioModel(
+  userId: string,
+  spaceId: string,
+  slot: ScenarioSlotId,
+  choice: ScenarioModelChoice | null,
+): Promise<void> {
+  const key = keyFor(userId, spaceId);
+  const next: ScenarioModels = { ...state };
+  if (choice) next[slot] = choice;
+  else delete next[slot];
+  state = next;
+  storageKey = key;
+  notify();
+  try {
+    if (Object.keys(next).length === 0) await SecureStore.deleteItemAsync(key);
+    else await SecureStore.setItemAsync(key, JSON.stringify(next));
+  } catch {
+    // SecureStore is unavailable on some hosts; the choice stays for this session.
+  }
+}
+
+/** The level a slot runs at: its own choice, else the slot's default. */
+export function scenarioThinkingLevel(
+  slot: ScenarioSlotId,
+  choice: ScenarioModelChoice | undefined,
+): ThinkingLevel | null {
+  if (choice?.thinkingLevel !== undefined) return choice.thinkingLevel;
+  return SCENARIO_DEFAULT_THINKING[slot];
+}
+
+/**
+ * Every slot as the router needs it, with the slots that name no model following 日常帮助. The
+ * backend's intent router can read this once it takes per-slot settings; until then the app keeps
+ * it here rather than writing fields the server does not accept yet.
+ */
+export function scenarioRoutingSnapshot(
+  daily: ScenarioModelChoice | null,
+): Record<ScenarioSlotId, ResolvedScenarioSlot | null> {
+  const resolve = (slot: ScenarioSlotId): ResolvedScenarioSlot | null => {
+    const own = state[slot];
+    if (own) return { model: own, thinkingLevel: scenarioThinkingLevel(slot, own), source: "slot" };
+    if (!daily) return null;
+    return { model: daily, thinkingLevel: scenarioThinkingLevel(slot, undefined), source: "daily" };
+  };
+  return {
+    fast: resolve("fast"),
+    code: resolve("code"),
+    heavy: resolve("heavy"),
+    image: resolve("image"),
+    video: resolve("video"),
+  };
+}
