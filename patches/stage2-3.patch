diff --git a/apps/mobile/components/press-scale.tsx b/apps/mobile/components/press-scale.tsx
new file mode 100644
index 0000000..2ee0d04
--- /dev/null
+++ b/apps/mobile/components/press-scale.tsx
@@ -0,0 +1,59 @@
+import type { ReactNode } from "react";
+import type { PressableProps, StyleProp, ViewStyle } from "react-native";
+import { Pressable } from "react-native";
+import Animated, {
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withSpring,
+  withTiming,
+} from "react-native-reanimated";
+
+/** How long a press takes to settle in, then the spring that lets it back out. */
+const PRESS_IN_MS = 90;
+const RELEASE_SPRING = { duration: 320, dampingRatio: 0.75 } as const;
+const RESTING_SCALE = 0.96;
+const RESTING_OPACITY = 0.92;
+
+/**
+ * A press that answers back: the control shrinks a hair while held and springs back on release.
+ *
+ * Only for buttons the app draws itself. A SwiftUI row, a native button or a `GlassSurface` with
+ * its own system feedback already answers a touch, and a second spring under it reads as a stutter.
+ */
+export function PressScale({
+  children,
+  containerStyle,
+  scaleTo = RESTING_SCALE,
+  ...props
+}: PressableProps & {
+  children: ReactNode;
+  /** Layout for the animated wrapper, which is what occupies space in the row. */
+  containerStyle?: StyleProp<ViewStyle>;
+  /** The smallest scale a press reaches, for tighter or larger controls. */
+  scaleTo?: number;
+}) {
+  const held = useSharedValue(0);
+  const reduceMotion = useReducedMotion();
+  const style = useAnimatedStyle(() => ({
+    opacity: 1 - held.value * (1 - RESTING_OPACITY),
+    transform: [{ scale: 1 - held.value * (1 - scaleTo) }],
+  }));
+  return (
+    <Animated.View style={[containerStyle, style]}>
+      <Pressable
+        {...props}
+        onPressIn={(event) => {
+          if (!reduceMotion) held.value = withTiming(1, { duration: PRESS_IN_MS });
+          props.onPressIn?.(event);
+        }}
+        onPressOut={(event) => {
+          held.value = reduceMotion ? 0 : withSpring(0, RELEASE_SPRING);
+          props.onPressOut?.(event);
+        }}
+      >
+        {children}
+      </Pressable>
+    </Animated.View>
+  );
+}
diff --git a/apps/mobile/components/scenario-model-slots.tsx b/apps/mobile/components/scenario-model-slots.tsx
new file mode 100644
index 0000000..8c19d46
--- /dev/null
+++ b/apps/mobile/components/scenario-model-slots.tsx
@@ -0,0 +1,200 @@
+import type { ModelCatalogEntry, ModelCredential, ThinkingLevel } from "@rakazo/contracts";
+import {
+  connectionDisplayName,
+  connectedBackupOptions,
+  modelRoleChoiceKey,
+  withConnectionName,
+} from "@rakazo/contracts";
+import { catalogEntryFor, connectionForModelChoice } from "@rakazo/core";
+import { useCallback, useEffect, useMemo, useSyncExternalStore } from "react";
+import type { ModelPickerRequest } from "../lib/model-picker-selection";
+import {
+  getScenarioModels,
+  loadScenarioModels,
+  SCENARIO_DEFAULT_THINKING,
+  type ScenarioSlotId,
+  saveScenarioModel,
+  subscribeScenarioModels,
+} from "../lib/scenario-models";
+import { MenuPicker } from "./menu-picker";
+import { SettingsGroup, SettingsRow } from "./settings-group";
+
+/** The slots 日常帮助 does not cover: 日常帮助 is the server's main model, on its own screen. */
+const SLOTS: { id: ScenarioSlotId; title: string; hint: string }[] = [
+  { id: "fast", title: "快速解答", hint: "秒回接话、闲聊与新 Bot 自我介绍" },
+  { id: "code", title: "代码与分析", hint: "编程、排障与逻辑分析" },
+  { id: "heavy", title: "高难任务", hint: "长链路规划与复杂工具执行" },
+  { id: "image", title: "生图模型", hint: "画图与修图，不经过思考" },
+  { id: "video", title: "生视频模型", hint: "生成视频，不经过思考" },
+];
+
+const THINKING_SLOTS: ScenarioSlotId[] = ["fast", "code", "heavy"];
+
+const LEVELS: { level: ThinkingLevel; label: string }[] = [
+  { level: "off", label: "关闭" },
+  { level: "minimal", label: "极简" },
+  { level: "low", label: "低" },
+  { level: "medium", label: "中" },
+  { level: "high", label: "高" },
+  { level: "xhigh", label: "更高" },
+  { level: "max", label: "极限" },
+];
+
+const DEFAULT_CHOICE = "default";
+
+function levelLabel(level: ThinkingLevel): string {
+  return LEVELS.find((entry) => entry.level === level)?.label ?? level;
+}
+
+/**
+ * The scenario slots the person can point at their own models: 快速解答, 代码与分析, 高难任务,
+ * 生图 and 生视频. Choices are kept on the device (with the default thinking level each slot
+ * recommends) and read back through `scenarioModelsForRouting` by the router.
+ */
+export function ScenarioModelSlots({
+  catalog,
+  credentials,
+  userId,
+  spaceId,
+  openPicker,
+}: {
+  catalog: ModelCatalogEntry[];
+  credentials: ModelCredential[];
+  userId: string;
+  spaceId: string;
+  openPicker: (request: ModelPickerRequest) => void;
+}) {
+  const choices = useSyncExternalStore(subscribeScenarioModels, getScenarioModels, getScenarioModels);
+
+  useEffect(() => {
+    if (userId) void loadScenarioModels(userId, spaceId);
+  }, [userId, spaceId]);
+
+  const options = useMemo(() => connectedBackupOptions(catalog, credentials), [catalog, credentials]);
+  const optionByKey = useMemo(
+    () => new Map(options.map((option) => [modelRoleChoiceKey(option), option])),
+    [options],
+  );
+
+  const modelLabel = useCallback(
+    (provider: string, modelId: string) =>
+      catalogEntryFor(catalog, provider, modelId)?.label ?? modelId,
+    [catalog],
+  );
+  const connectionLabel = useCallback(
+    (provider: string, modelId: string) => {
+      const entry = catalogEntryFor(catalog, provider, modelId);
+      const name = entry?.providerName ?? provider;
+      const connection = connectionForModelChoice(credentials, { provider, modelId });
+      return connection ? connectionDisplayName(connection, name) : name;
+    },
+    [catalog, credentials],
+  );
+
+  const pick = (slot: ScenarioSlotId, title: string, withThinking: boolean) => {
+    const current = choices[slot];
+    const currentKey = current
+      ? modelRoleChoiceKey({
+          provider: current.provider,
+          modelId: current.modelId,
+          ...(current.credentialId ? { credentialId: current.credentialId } : {}),
+        })
+      : "";
+    openPicker({
+      title,
+      selectedKey: currentKey,
+      emptyMessage: "没有匹配的模型",
+      choices: [
+        {
+          key: "clear",
+          label: "跟随日常帮助",
+          modelLabel: "跟随日常帮助",
+        },
+        ...options.map((option) => ({
+          key: modelRoleChoiceKey(option),
+          label: withConnectionName(option.label, option.connectionName),
+          modelLabel: option.label,
+          providerLabel: option.connectionName,
+          provider: option.provider,
+          modelId: option.modelId,
+        })),
+      ],
+      onSelect: (choice) => {
+        if (choice.key === "clear") {
+          void saveScenarioModel(userId, spaceId, slot, null);
+          return;
+        }
+        const option = optionByKey.get(choice.key);
+        if (!option) return;
+        void saveScenarioModel(userId, spaceId, slot, {
+          provider: option.provider,
+          modelId: option.modelId,
+          ...(option.credentialId ? { credentialId: option.credentialId } : {}),
+          // A new model starts on the slot's own thinking default.
+          ...(withThinking && current?.thinkingLevel !== undefined
+            ? { thinkingLevel: current.thinkingLevel }
+            : {}),
+        });
+      },
+    });
+  };
+
+  const setThinking = (slot: ScenarioSlotId, key: string) => {
+    const current = choices[slot];
+    if (!current) return;
+    void saveScenarioModel(userId, spaceId, slot, {
+      ...current,
+      thinkingLevel: key === DEFAULT_CHOICE ? null : (key as ThinkingLevel),
+    });
+  };
+
+  const thinkingChoices = (slot: ScenarioSlotId) => [
+    {
+      key: DEFAULT_CHOICE,
+      label: `默认（${levelLabel(SCENARIO_DEFAULT_THINKING[slot] ?? "off")}）`,
+    },
+    ...LEVELS.map((entry) => ({ key: entry.level, label: entry.label })),
+  ];
+
+  return (
+    <>
+      <SettingsGroup label="场景模型">
+        {SLOTS.map((slot) => {
+          const chosen = choices[slot.id];
+          const detail = chosen
+            ? `${modelLabel(chosen.provider, chosen.modelId)} · ${connectionLabel(chosen.provider, chosen.modelId)}`
+            : `${slot.hint} · 未选时跟随日常帮助`;
+          return (
+            <SettingsRow
+              key={slot.id}
+              accessibilityRole="button"
+              chevron="right"
+              title={slot.title}
+              detail={detail}
+              onPress={() => pick(slot.id, slot.title, Boolean(SCENARIO_DEFAULT_THINKING[slot.id]))}
+            />
+          );
+        })}
+      </SettingsGroup>
+      <SettingsGroup
+        label="思考强度"
+        footer="保持默认即可；不支持思考的模型会自动忽略该设置。"
+      >
+        {THINKING_SLOTS.map((slot) => {
+          const chosen = choices[slot];
+          const title = SLOTS.find((entry) => entry.id === slot)?.title ?? slot;
+          return (
+            <MenuPicker
+              key={slot}
+              label={title}
+              choices={thinkingChoices(slot)}
+              value={chosen?.thinkingLevel ?? DEFAULT_CHOICE}
+              disabled={!chosen}
+              onChange={(key) => setThinking(slot, key)}
+            />
+          );
+        })}
+      </SettingsGroup>
+    </>
+  );
+}
