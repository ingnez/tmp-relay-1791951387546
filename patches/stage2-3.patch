diff --git a/apps/mobile/components/home-bottom-bar.tsx b/apps/mobile/components/home-bottom-bar.tsx
new file mode 100644
index 0000000..49ac426
--- /dev/null
+++ b/apps/mobile/components/home-bottom-bar.tsx
@@ -0,0 +1,150 @@
+import Animated, { FadeInUp } from "react-native-reanimated";
+import { StyleSheet, Text, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { mobileTokens } from "../lib/appearance";
+import { native, useThemedStyles } from "../lib/native";
+import { GlassSurface } from "./glass-surface";
+import { NativeSymbol } from "./native-symbol";
+import { PressScale } from "./press-scale";
+
+/** Sits above the home indicator, clear of it by this much. */
+const DOCK_GAP = 10;
+
+/**
+ * The bar that floats over the bottom of the home screen: the button that opens the app
+ * connections on one side, the search pill on the other, and the activity switch between them.
+ * Everything is drawn here, so it is the app's own press feedback rather than the system's.
+ */
+export function HomeBottomBar({
+  activityMode,
+  onToggleActivity,
+  onOpenIntegrations,
+  onOpenSearch,
+}: {
+  activityMode: boolean;
+  onToggleActivity: () => void;
+  onOpenIntegrations: () => void;
+  onOpenSearch: () => void;
+}) {
+  const styles = useThemedStyles(createBottomBarStyles);
+  const tokens = mobileTokens();
+  const insets = useSafeAreaInsets();
+  return (
+    <Animated.View
+      entering={FadeInUp.duration(240)}
+      pointerEvents="box-none"
+      style={[styles.dock, { paddingBottom: Math.max(insets.bottom, DOCK_GAP) }]}
+    >
+      <GlassSurface
+        fallbackStyle={styles.circleFill}
+        shape="circle"
+        style={styles.circle}
+      >
+        <PressScale
+          accessibilityLabel="连接应用"
+          accessibilityRole="button"
+          hitSlop={6}
+          onPress={onOpenIntegrations}
+          style={styles.buttonInner}
+        >
+          <NativeSymbol ios="square.grid.2x2" android="grid-outline" size={20} />
+        </PressScale>
+      </GlassSurface>
+      <GlassSurface
+        fallbackStyle={styles.circleFill}
+        shape="circle"
+        style={styles.circle}
+        tint={activityMode ? tokens.primary : undefined}
+      >
+        <PressScale
+          accessibilityLabel="活动"
+          accessibilityRole="button"
+          accessibilityState={{ selected: activityMode }}
+          hitSlop={6}
+          onPress={onToggleActivity}
+          style={styles.buttonInner}
+        >
+          <NativeSymbol
+            ios={activityMode ? "bell.fill" : "bell"}
+            android={activityMode ? "notifications" : "notifications-outline"}
+            size={18}
+            color={activityMode ? tokens.primaryForeground : tokens.foreground}
+          />
+        </PressScale>
+      </GlassSurface>
+      <View style={styles.spacer} />
+      <GlassSurface
+        fallbackStyle={styles.pillFill}
+        shape="capsule"
+        style={styles.pill}
+      >
+        <PressScale accessibilityRole="button" onPress={onOpenSearch} style={styles.pillInner}>
+          <View style={styles.pillContent}>
+            <NativeSymbol ios="magnifyingglass" android="search" size={16} />
+            <Text style={styles.pillLabel}>搜索</Text>
+          </View>
+        </PressScale>
+      </GlassSurface>
+    </Animated.View>
+  );
+}
+
+/** The space the bar takes off the list, so its last row clears the bar. */
+export const HOME_BOTTOM_BAR_HEIGHT = 55 + DOCK_GAP;
+
+function createBottomBarStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    dock: {
+      position: "absolute",
+      left: 16,
+      right: 16,
+      bottom: 0,
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 10,
+    },
+    circle: {
+      width: 50,
+      height: 50,
+      alignItems: "center",
+      justifyContent: "center",
+    },
+    circleFill: {
+      borderRadius: 25,
+      backgroundColor: native.fillPressed,
+    },
+    buttonInner: {
+      width: 50,
+      height: 50,
+      alignItems: "center",
+      justifyContent: "center",
+    },
+    spacer: {
+      flex: 1,
+    },
+    pill: {
+      height: 50,
+      justifyContent: "center",
+      paddingHorizontal: 4,
+    },
+    pillFill: {
+      borderRadius: 25,
+      backgroundColor: native.fillPressed,
+    },
+    pillInner: {
+      height: 50,
+      justifyContent: "center",
+    },
+    pillContent: {
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 7,
+      paddingHorizontal: 14,
+    },
+    pillLabel: {
+      color: tokens.mutedForeground,
+      fontSize: 15,
+    },
+  });
+}
diff --git a/apps/mobile/components/home-hero.tsx b/apps/mobile/components/home-hero.tsx
new file mode 100644
index 0000000..eab1611
--- /dev/null
+++ b/apps/mobile/components/home-hero.tsx
@@ -0,0 +1,113 @@
+import type { SpaceBot } from "@rakazo/contracts";
+import { isRunWorking } from "@rakazo/core";
+import { Pressable, StyleSheet, Text, View } from "react-native";
+import { mobileTokens, resolveMobileAppearance } from "../lib/appearance";
+import type { MobileBot } from "../lib/mobile-types";
+import { native, useThemedStyles } from "../lib/native";
+import { previewSnippet } from "../lib/preview";
+import { BotAvatar } from "./bot-avatar";
+import { FALLBACK_COLOR } from "./inbox-rows";
+
+/**
+ * The bot the home screen puts first, the way a chat app centres its one main character: a large
+ * avatar, its name with a state dot, and the first words of its last message. Everything else
+ * stays a list row below.
+ */
+export function HomeHero({
+  bot,
+  onOpen,
+}: {
+  bot: MobileBot | SpaceBot;
+  onOpen: (bot: MobileBot | SpaceBot) => void;
+}) {
+  const styles = useThemedStyles(createHeroStyles);
+  const tokens = mobileTokens();
+  const working = isRunWorking(bot.status);
+  const preview = previewSnippet(bot.preview ?? "", 64);
+  const dotColor = working ? tokens.workingDot : bot.unread ? tokens.unread : null;
+  const state = working ? "正在处理" : bot.unread ? "有新消息" : null;
+  return (
+    <View style={styles.hero}>
+      <Pressable
+        accessible
+        accessibilityLabel={[bot.name, state, preview].filter(Boolean).join(", ")}
+        accessibilityHint="打开与主 Bot 的对话"
+        accessibilityRole="button"
+        onPress={() => onOpen(bot)}
+        style={({ pressed }) => [styles.heroButton, pressed && styles.heroPressed]}
+      >
+        <BotAvatar
+          avatarSet={bot.avatarSet}
+          color={bot.color || FALLBACK_COLOR}
+          identity={bot.id}
+          motion="lazy"
+          size={88}
+          status={bot.status}
+        />
+        <View style={styles.nameRow}>
+          <Text numberOfLines={1} style={styles.name}>
+            {bot.name}
+          </Text>
+          {dotColor ? <View style={[styles.stateDot, { backgroundColor: dotColor }]} /> : null}
+        </View>
+        {preview ? (
+          <Text numberOfLines={1} style={[styles.preview, bot.unread && styles.previewUnread]}>
+            {preview}
+          </Text>
+        ) : null}
+      </Pressable>
+    </View>
+  );
+}
+
+export function createHeroStyles() {
+  const tokens = mobileTokens();
+  const appearance = resolveMobileAppearance();
+  return StyleSheet.create({
+    hero: {
+      alignItems: "center",
+      paddingTop: 6,
+      paddingBottom: 18,
+      paddingHorizontal: 20,
+    },
+    heroButton: {
+      alignItems: "center",
+      gap: 8,
+      paddingHorizontal: 16,
+      paddingVertical: 8,
+      borderRadius: 28,
+      borderCurve: "continuous",
+      maxWidth: "100%",
+    },
+    heroPressed: {
+      opacity: 0.7,
+    },
+    nameRow: {
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 6,
+      maxWidth: "100%",
+    },
+    name: {
+      color: native.label,
+      fontSize: 17,
+      fontWeight: "600",
+      writingDirection: "auto",
+    },
+    stateDot: {
+      width: 7,
+      height: 7,
+      borderRadius: 3.5,
+    },
+    preview: {
+      color: appearance === "light" ? tokens.mutedForeground : native.secondaryLabel,
+      fontSize: 14,
+      textAlign: "center",
+      writingDirection: "auto",
+    },
+    previewUnread: {
+      color: native.label,
+      fontWeight: "500",
+    },
+  });
+}
